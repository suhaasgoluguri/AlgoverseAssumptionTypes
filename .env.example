# Copy this file to .env and fill in your values. .env is gitignored.
#
# clients.py calls load_dotenv() at import, so these are picked up
# automatically by run_pilot.py, oracle_check.py, adoption_check.py and
# run_judge.py. You do not need to re-export them in each shell session.
#
#   Copy-Item .env.example .env    (PowerShell)
#   cp .env.example .env           (bash)

# --- Azure OpenAI ---------------------------------------------------------
# Azure Portal -> your Azure OpenAI resource -> Keys and Endpoint.
AZURE_OPENAI_API_KEY=key_here

# Must be the v1 base URL, ENDING IN /openai/v1 — this is the AI Foundry
# style endpoint. The classic azure_endpoint + api_version routing 404s on
# Foundry resources, which is why there is no API_VERSION variable here.
#   e.g. https://your-resource.services.ai.azure.com/openai/v1
AZURE_OPENAI_ENDPOINT=url_here

# The name YOU gave the deployment in Azure AI Foundry (the deployment name,
# not necessarily the model name). This is also recorded as the model id in
# every run manifest, so it ends up in the provenance for every result.
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# --- Anthropic ------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-key-here

# Blinded semantic judge, used by scripts/run_judge.py. May also be passed
# with --model; keep the exact ID in the output provenance.
ANTHROPIC_JUDGE_MODEL=claude-sonnet-5
