# Copy this file to .env and fill in your Azure OpenAI values.
# Find them in Azure Portal -> your Azure OpenAI resource -> Keys and Endpoint.

AZURE_OPENAI_API_KEY=key_here
AZURE_OPENAI_ENDPOINT=url_here
AZURE_OPENAI_API_VERSION=2024-10-21

# The name YOU gave the GPT-5.4 mini deployment in Azure AI Foundry
# (the deployment name, not necessarily the model name).
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini

# Blinded semantic judge. The model may also be passed with
# scripts/run_judge.py --model; keep the exact ID in the output provenance.
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_JUDGE_MODEL=claude-sonnet-5
