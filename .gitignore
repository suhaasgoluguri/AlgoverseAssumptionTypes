.env
__pycache__/
*.pyc
.venv/
venv/
.DS_Store
*.egg-info/
.ipynb_checkpoints/
# Raw run data. Large, machine-specific, and reproducible from the corpus
# plus a run manifest, so it is distributed alongside the paper rather
# than tracked here. docs/sample_records.jsonl is the in-repo example.
outputs/raw/

# Generated HTML reports. Rebuilt from the run they cite.
reports/

# Run logs, anywhere in the tree. Shell redirections of console progress, not
# pipeline output: the structured form of the same run is in records.jsonl and
# results.jsonl. Tracking them would also trip the launcher's clean-worktree
# gate. The previous name-by-name patterns missed any log named differently.
*.log

# Internal working documents. Team-facing, not reviewer-facing, and none of
# them is referenced by anything in the repo.
docs/PINNED.md
docs/TEAM_BRIEFING.html

# Page rasters of docs/analysis/*.pdf plus the superseded July pilot analysis.
docs/analysis/

# tool caches
.pytest_cache/
.ruff_cache/

# Local working notes. Untracked deliberately: collaborator names, venue
# details, cost figures, unpublished results. Nothing in the codebase reads it.
CLAUDE.md

# Diagnostic and validation artifacts. Each is regenerable by re-running the
# script that wrote it, none is cited by the write-up, and together they were
# 3.3 MB of the 7.9 MB repo. outputs/oracle_34*.json is deliberately NOT
# matched here: it is the corpus-validity ceiling test for the active corpus,
# pinned to its sha256, and it is 7 KB.
outputs/adoption_*.json
outputs/oracle_*.json
outputs/README.md
outputs/transit_diag.json
outputs/validation/oracle_*.json
outputs/validation/20260803_scenarios_rebuilt.json
outputs/validation/scenarios_scope_live*.json
# Cost-control launchers, not reproduction steps. The six-scenario corpus was
# a byte duplicate of six scenarios already in data/, which is a drift hazard
# given that corpus bytes are hashed into every run manifest.
outputs/validation/run_scope_live6.ps1
outputs/validation/run_scope_budget_smoke8000.ps1
outputs/validation/run_tool_v2_azure_six.ps1

# Internal self-audit; team-facing, unreferenced.
docs/RESEARCH_AUDIT.md
