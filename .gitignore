.env
__pycache__/
*.pyc
.venv/
venv/
.DS_Store
*.egg-info/
.ipynb_checkpoints/
# outputs/ is ignored by default: run data is large and machine-specific.
# The analysis artifacts behind the paper's numbers are tracked by exception
# (added with -f); see "Reproducing the paper's tables" in README.md. The
# per-agent-round records.jsonl files stay out at ~300 MB each.
outputs/

# Generated HTML reports. Rebuilt from the run they cite.
reports/

# docs/ is ignored by default: what lived here was team-facing rather than
# reviewer-facing (a deferred-decision log, an internal status write-up, a
# self-audit, page rasters of a superseded pilot analysis). docs/figures/ is
# tracked by exception -- it holds the table and figure generators and their
# committed output, which the paper depends on.
# 'docs/*' not 'docs/' -- excluding the directory itself stops git descending
# into it, which would silently ignore anything new added under docs/figures/.
docs/*
!docs/figures/

# Run logs, anywhere in the tree. Shell redirections of console progress, not
# pipeline output: the structured form of the same run is in records.jsonl and
# results.jsonl. Tracking them would also trip the launcher's clean-worktree
# gate. The previous name-by-name patterns missed any log named differently.
*.log


# tool caches
.pytest_cache/
.ruff_cache/

# Local working notes. Untracked deliberately: collaborator names, venue
# details, cost figures, unpublished results. Nothing in the codebase reads it.
CLAUDE.md


# Superseded scenario corpora. 2.0 MB that no reproduction path touches: the
# confirmatory run reads data/scenarios_hidden_profile_candidates.json and the
# analysis reads a run snapshot. The written account of how the corpus evolved
# lives in data/README.md, which is the part a reviewer actually needs.
data/archive/*.json
# Exception: scripts/audit_scenarios.py and tests/test_scenarios_fixed.py both
# read this corpus, and the audit's rules (letter-balance quotas, release-round
# checks) describe the Track-A design, so they cannot be repointed at the
# active corpus -- it fails 106 of them by construction.
!data/archive/scenarios_fixed.json

# Replication launcher for a second model family. Three attempts were made and
# none reached state=complete, so no reported result rests on it.
scripts/run_tool_v2_azure_deepseekflash.ps1

# Leakage measurement, kept local for now. The raw transcripts it reads are
# not distributed either, so a tracked copy could not be run from a clone.
scripts/measure_anonymity_leakage.py
outputs/raw/**/analysis/anonymity_leakage.json
