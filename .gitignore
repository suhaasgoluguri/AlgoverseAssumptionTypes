.env
__pycache__/
*.pyc
.venv/
venv/
.DS_Store
*.egg-info/
.ipynb_checkpoints/
# Nothing under outputs/ is tracked. Run data is large and machine-specific,
# every artifact here is regenerable from the corpus plus a run manifest, and
# the runs themselves are distributed alongside the paper.
outputs/

# Generated HTML reports. Rebuilt from the run they cite.
reports/

# Nothing under docs/ is tracked. What remained was team-facing rather than
# reviewer-facing: a deferred-decision log, an internal status write-up, a
# self-audit, and page rasters of a superseded pilot analysis.
docs/

# Run logs, anywhere in the tree. Shell redirections of console progress, not
# pipeline output: the structured form of the same run is in records.jsonl and
# results.jsonl. Tracking them would also trip the launcher's clean-worktree
# gate. The previous name-by-name patterns missed any log named differently.
*.log


# tool caches
.pytest_cache/
.ruff_cache/

# Local working notes. Untracked deliberately: collaborator names, venue
# details, cost figures, unpublished results. Nothing in the codebase reads it.
CLAUDE.md


# Superseded scenario corpora. 2.0 MB that no reproduction path touches: the
# confirmatory run reads data/scenarios_hidden_profile_candidates.json and the
# analysis reads a run snapshot. The written account of how the corpus evolved
# lives in data/README.md, which is the part a reviewer actually needs.
data/archive/*.json
# Exception: scripts/audit_scenarios.py and tests/test_scenarios_fixed.py both
# read this corpus, and the audit's rules (letter-balance quotas, release-round
# checks) describe the Track-A design, so they cannot be repointed at the
# active corpus -- it fails 106 of them by construction.
!data/archive/scenarios_fixed.json
